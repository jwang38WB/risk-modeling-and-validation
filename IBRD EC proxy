# =============================================================================
# 3. THE MODEL
# =============================================================================
def public_pd(rating_series: pd.Series) -> pd.Series:
    """Map a Series of rating labels to the illustrative public sovereign PD curve."""
    return rating_series.map(RATING_PD)


def stressed_pd(pd_cond: np.ndarray, rho: float, alpha: float) -> np.ndarray:
    """
    Single-factor Vasicek / Merton conditional (stressed) default probability.

        PD(alpha) = N[ (N^-1(PD) + sqrt(rho)*N^-1(alpha)) / sqrt(1-rho) ]

    This is exactly the formula underlying corporate KMV portfolio capital and
    the Basel IRB risk-weight function -- here applied to sovereign PDs.
    """
    pd_cond = np.clip(pd_cond, 1e-9, 0.9999)  # guard N^-1(0) / N^-1(1) singularities
    z = (norm.ppf(pd_cond) + np.sqrt(rho) * norm.ppf(alpha)) / np.sqrt(1 - rho)
    return norm.cdf(z)


def run_model(df: pd.DataFrame, lgd: float, rho: float, alpha: float, h: float) -> pd.DataFrame:
    """
    Full per-country Economic Capital calculation.

        Conditional PD_i        = h * PD_public(rating_i)      [preferred-creditor haircut]
        Stressed PD_i(alpha)    = Vasicek formula above
        Capital rate K_i        = LGD * [PD_i(alpha) - PD_i]
        Economic Capital EC_i   = EAD_i * K_i
    """
    out = df.copy()
    out["public_pd"] = public_pd(out["rating"])
    out["cond_pd"] = np.clip(out["public_pd"] * h, 0, 0.9999)
    out["stressed_pd"] = stressed_pd(out["cond_pd"].to_numpy(), rho, alpha)
    out["lgd"] = lgd
    out["el_mm"] = out["ead_mm"] * out["cond_pd"] * out["lgd"]
    out["capital_rate"] = out["lgd"] * (out["stressed_pd"] - out["cond_pd"])
    out["ec_mm"] = out["ead_mm"] * out["capital_rate"]
    return out


def portfolio_ec(df: pd.DataFrame, lgd: float, rho: float, alpha: float, h: float) -> float:
    """Portfolio Economic Capital ($mm) -- the single-factor ASRF sum used by the grids below."""
    result = run_model(df, lgd, rho, alpha, h)
    return result["ec_mm"].sum()


