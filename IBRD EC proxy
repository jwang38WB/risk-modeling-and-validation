# 6. MONTE CARLO CROSS-CHECK
# =============================================================================
def expand_for_granularity(df: pd.DataFrame, n_split: int = 100) -> pd.DataFrame:
    """
    The 'All other IBRD borrowers' row represents ~120 real countries lumped into
    one line for readability. Simulating it as one giant obligor would create
    artificial single-name concentration risk that doesn't exist in reality.
    For Monte Carlo purposes only, split it into n_split equal-sized pseudo-
    obligors (same rating/PD, same correlation to the systematic factor, but
    independent idiosyncratic risk) -- a standard granularity-adjustment trick.
    """
    mask = df["region"] == "Diversified"
    lumped = df[mask]
    rest = df[~mask]
    pieces = []
    for _, row in lumped.iterrows():
        sub = pd.DataFrame([row] * n_split)
        sub["ead_mm"] = row["ead_mm"] / n_split
        sub["country"] = [f"{row['country']} #{i+1}" for i in range(n_split)]
        pieces.append(sub)
    return pd.concat([rest] + pieces, ignore_index=True)


def monte_carlo(df: pd.DataFrame, lgd: float, rho: float, h: float,
                 n_sims: int = 200_000, alpha: float = 0.999, seed: int = 42,
                 granularity_split: int = 100) -> dict:
    """
    Single-factor Gaussian-copula default simulation -- the "real" way portfolio
    credit models (incl. Moody's/KMV and CreditMetrics) build the loss
    distribution, as a cross-check on the closed-form Vasicek/ASRF number above.

    For each simulation draw:
        asset_i = sqrt(rho)*Z_systematic + sqrt(1-rho)*Z_idiosyncratic_i
        default_i occurs if asset_i < N^-1(cond_pd_i)
        loss = sum_i EAD_i * LGD * default_i

    The diversified "all other borrowers" bucket is first split into many equal
    pseudo-obligors (see expand_for_granularity) so it isn't simulated as one
    artificially lumpy $91.7bn obligor.
    """
    sim_df = expand_for_granularity(df, n_split=granularity_split)
    rng = np.random.default_rng(seed)
    cond_pd = np.clip((sim_df["rating"].map(RATING_PD) * h).to_numpy(), 1e-9, 0.9999)
    default_threshold = norm.ppf(cond_pd)          # per-country asset threshold
    ead = sim_df["ead_mm"].to_numpy()

    Z = rng.standard_normal(n_sims)                              # systematic factor
    eps = rng.standard_normal((n_sims, len(sim_df)))              # idiosyncratic
    assets = np.sqrt(rho) * Z[:, None] + np.sqrt(1 - rho) * eps
    defaults = assets < default_threshold[None, :]
    losses = defaults @ (ead * lgd)                               # $mm per simulation

    el = losses.mean()
    var_alpha = np.quantile(losses, alpha)
    ec_simulated = var_alpha - el
    ec_analytical = portfolio_ec(df, lgd, rho, alpha, h)

    return dict(losses=losses, el=el, var_alpha=var_alpha,
                ec_simulated=ec_simulated, ec_analytical=ec_analytical,
                n_obligors_simulated=len(sim_df))


def print_monte_carlo(mc: dict):
    print("=" * 78)
    print("MONTE CARLO CROSS-CHECK — single-factor Gaussian-copula simulation")
    print("=" * 78)
    print(f"Simulations:                     {len(mc['losses']):,}")
    print(f"Obligors simulated (post-split):  {mc['n_obligors_simulated']:,}")
    print(f"Simulated Expected Loss:         ${mc['el']:,.1f}mm")
    print(f"Simulated 99.9% VaR:              ${mc['var_alpha']:,.1f}mm")
    print(f"Simulated Economic Capital:       ${mc['ec_simulated']:,.1f}mm")
    print(f"Analytical (Vasicek/ASRF) EC:     ${mc['ec_analytical']:,.1f}mm")
    diff = mc["ec_simulated"] - mc["ec_analytical"]
    print(f"Difference (sim - analytical):    ${diff:,.1f}mm ({diff/mc['ec_analytical']:.1%})")
    print("-" * 78)
