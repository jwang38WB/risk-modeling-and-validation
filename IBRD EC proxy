def sensitivity_grid_alpha_h():
    alpha_vals = [0.99, 0.995, 0.999, 0.9995, 0.9999]
    h_vals = [0.10, 0.20, 0.35, 0.50, 0.75, 0.99]
    grid = pd.DataFrame(index=pd.Index(alpha_vals, name="alpha"),
                         columns=pd.Index(h_vals, name="h"), dtype=float)
    for a in alpha_vals:
        for h in h_vals:
            grid.loc[a, h] = portfolio_ec(PORTFOLIO, lgd=BASE["lgd"], rho=BASE["rho"],
                                           alpha=a, h=h)
    return grid


def tornado_sensitivity():
    base_ec = portfolio_ec(PORTFOLIO, **BASE)
    specs = [
        ("LGD",                     0.05,  0.20,
         lambda v: portfolio_ec(PORTFOLIO, lgd=v, rho=BASE["rho"], alpha=BASE["alpha"], h=BASE["h"])),
        ("Correlation (rho)",       0.10,  0.35,
         lambda v: portfolio_ec(PORTFOLIO, lgd=BASE["lgd"], rho=v, alpha=BASE["alpha"], h=BASE["h"])),
        ("Confidence (alpha)",      0.99,  0.9999,
         lambda v: portfolio_ec(PORTFOLIO, lgd=BASE["lgd"], rho=BASE["rho"], alpha=v, h=BASE["h"])),
        ("Preferred-creditor h",    0.10,  0.99,
         lambda v: portfolio_ec(PORTFOLIO, lgd=BASE["lgd"], rho=BASE["rho"], alpha=BASE["alpha"], h=v)),
    ]
    rows = []
    for name, lo, hi, fn in specs:
        ec_lo, ec_hi = fn(lo), fn(hi)
        rows.append(dict(parameter=name, low_value=lo, high_value=hi,
                          ec_at_low=ec_lo, ec_at_high=ec_hi, range_mm=abs(ec_hi - ec_lo)))
    df = pd.DataFrame(rows).sort_values("range_mm", ascending=False)
    return base_ec, df


