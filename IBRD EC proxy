    ax.set_xlabel("Simulated portfolio loss ($mm)")
    ax.set_ylabel("Frequency")
    ax.set_title("Monte Carlo simulated portfolio loss distribution")
    ax.set_xlim(0, np.quantile(mc["losses"], 0.9995))
    ax.legend()
    fig.tight_layout()
    fig.savefig(os.path.join(OUT_DIR, "chart_mc_loss_distribution.png"), dpi=150)
