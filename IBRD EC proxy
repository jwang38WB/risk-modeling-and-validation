    ax.set_xlabel("Portfolio Economic Capital ($mm)")
    ax.set_title("Tornado: one-at-a-time sensitivity")
    ax.legend()
    fig.tight_layout()
    fig.savefig(os.path.join(OUT_DIR, "chart_tornado.png"), dpi=150)
    plt.close(fig)

